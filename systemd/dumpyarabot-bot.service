[Unit]
Description=Dumpyarabot Telegram bot
After=dumpyarabot-redis.service
Wants=dumpyarabot-redis.service
PartOf=dumpyarabot.target
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
User=jenkins
WorkingDirectory=/var/lib/jenkins/dumpbot
Environment=PATH=/var/lib/jenkins/.cargo/bin:/var/lib/jenkins/.local/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
# pydantic-settings reads `.env` from the working directory, so no EnvironmentFile needed.
ExecStart=/var/lib/jenkins/.cargo/bin/uv run --python 3.14 --no-sync -m dumpyarabot
Restart=on-failure
RestartSec=10
TimeoutStopSec=30

[Install]
WantedBy=multi-user.target
